# Frontend configuration (copy to .env.local for local development).
# These values are PUBLIC: they end up in the JavaScript served by GitHub Pages.
# Never put service_role keys, SMTP passwords or other secrets here.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key. Safe in the browser ONLY because every table uses RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Base path on GitHub Pages (repository name). Default: /cader-mailer/
VITE_BASE=/cader-mailer/

# ---------------------------------------------------------------------------
# Server-side secrets (DO NOT put them in this file). Set them with:
#   supabase secrets set NAME=value
# SENDER_SECRET_KEY  32 random bytes, base64 (openssl rand -base64 32) – encrypts SMTP passwords
# CRON_SECRET        long random string (openssl rand -hex 32) – authorises pg_cron -> process-queue
# SITE_URL           https://<user>.github.io/cader-mailer/ – invite/password-reset redirect
# ALLOWED_ORIGINS    https://<user>.github.io,http://localhost:5173 – CORS allowlist
